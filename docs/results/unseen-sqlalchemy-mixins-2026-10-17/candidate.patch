+def _contains_eager_option(root_cls, path, aliases):
+    """Build a ``contains_eager`` option for an aliased relationship path.
+
+    SQLAlchemy 2.0 no longer accepts strings as loader option paths, so the
+    path is expressed as a chain of mapped attributes, each narrowed to its
+    alias with ``of_type()``.
+    """
+    parts = path.split(RELATION_SPLITTER)
+    option = None
+    for index in range(len(parts)):
+        prefix = RELATION_SPLITTER.join(parts[:index + 1])
+        alias, relationship = aliases[prefix]
+        attribute = relationship.of_type(alias)
+        if option is None:
+            option = contains_eager(attribute)
+        else:
+            option = option.contains_eager(attribute)
+    return option
+
