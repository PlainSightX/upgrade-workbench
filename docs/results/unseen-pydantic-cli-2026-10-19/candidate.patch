+def __get_field_extra(field: pydantic.fields.FieldInfo) -> T.Dict[str, T.Any]:
+    """
+    Return the extra keyword arguments supplied to ``pydantic.Field``.
+
+    Pydantic 2 stores unknown ``Field`` keywords (e.g. ``cli=...``) inside
+    ``json_schema_extra``; Pydantic 1 exposed them through ``field_info.extra``.
+    """
+    extra = getattr(field, "json_schema_extra", None)
+    if isinstance(extra, dict):
+        return extra
+
+    field_info = getattr(field, "field_info", None)
+    if field_info is not None:
+        return getattr(field_info, "extra", None) or {}
+
+    return {}
+
+
+def __unwrap_optional(annotation: T.Any) -> T.Tuple[T.Any, bool]:
+    """Split ``Optional[X]`` (``Union[X, None]``) into ``(X, True)``."""
+    if get_origin(annotation) is not T.Union:
+        return annotation, False
+
+    inner = [a for a in get_args(annotation) if a is not type(None)]
+    if len(inner) == 1:
+        return inner[0], True
+    return annotation, False
+
+
+def __is_multi_value(annotation: T.Any) -> bool:
+    """True for ``List``/``Set`` style annotations, which take several values."""
+    if get_origin(annotation) in {list, set, frozenset}:
+        return True
+    return annotation in {list, set, frozenset}
+
+
+def __is_multi_value_field(field: pydantic.fields.FieldInfo) -> bool:
+    annotation, _ = __unwrap_optional(field.annotation)
+    return __is_multi_value(annotation)
+
+
+def __get_field_type(field: pydantic.fields.FieldInfo) -> T.Tuple[T.Any, bool]:
+    """Return the CLI facing type of the field and whether ``None`` is allowed."""
+    annotation, allow_none = __unwrap_optional(field.annotation)
+    if __is_multi_value(annotation):
+        args = get_args(annotation)
+        if args:
+            annotation = args[0]
+    return annotation, allow_none
+
