+def _get_model_config_attribute(
+    cls: T.Type[M], attr_name: str, default: T.Any
+) -> T.Any:
+    """
+    Read a CLI setting the user declared on the nested ``class Config``.
+
+    Pydantic 2 deprecated the inner ``Config`` class; depending on the
+    installed version the user settings are either still available as a plain
+    class attribute or are folded into the ``model_config`` dict, so both
+    spellings are accepted here.
+    """
+    config_class = cls.__dict__.get("Config", None)
+    if config_class is None:
+        config_class = getattr(cls, "Config", None)
+    if config_class is not None and hasattr(config_class, attr_name):
+        return getattr(config_class, attr_name)
+
+    model_config = getattr(cls, "model_config", None)
+    if isinstance(model_config, dict) and attr_name in model_config:
+        return model_config[attr_name]
+
+    return default
+
