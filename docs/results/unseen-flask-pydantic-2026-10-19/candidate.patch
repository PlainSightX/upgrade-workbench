+def _is_complex_annotation(annotation: Any) -> bool:
+    if get_origin(annotation) is Annotated or hasattr(annotation, "__metadata__"):
+        return _is_complex_annotation(get_args(annotation)[0])
+    origin = get_origin(annotation)
+    if origin is None:
+        return False
+    if origin is Union or (UnionType is not None and origin is UnionType):
+        return any(_is_complex_annotation(arg) for arg in get_args(annotation))
+    if origin in (list, tuple, set, frozenset, dict):
+        return True
+    return (
+        isinstance(origin, type)
+        and issubclass(origin, (Mapping, Sequence, AbstractSet))
+        and origin not in (str, bytes, bytearray)
+    )
 
 
